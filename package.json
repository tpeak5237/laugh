{
  "name": "laughing-seed",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/rng.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test && npm run test:e2e",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry": "npm run build && wrangler deploy --dry-run",
    "scan:secrets": "node scripts/check-secrets.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "wrangler": "4.151.3"
  },
  "dependencies": {
    "@fontsource/kanit": "5.3.0",
    "@fontsource/lilita-one": "5.3.0",
    "@fontsource/mitr": "5.3.0"
  }
}
